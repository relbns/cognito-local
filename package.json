{
  "name": "cognito-emulator",
  "version": "1.0.0",
  "description": "A local emulator of Amazon Cognito User Pools, with a seed file, local triggers and a CLI",
  "author": "Ariel Benesh",
  "license": "MIT",
  "keywords": [
    "cognito",
    "aws",
    "emulator",
    "local",
    "mock",
    "testing",
    "oauth2",
    "oidc"
  ],
  "homepage": "https://github.com/relbns/cognito-local#readme",
  "bugs": {
    "url": "https://github.com/relbns/cognito-local/issues"
  },
  "bin": {
    "cognito-emulator": "lib/bin/cli.js",
    "cognito-local": "lib/bin/cli.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "examples",
    "licenses"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc --emitDeclarationOnly --project tsconfig.build.json && esbuild $(find src -name '*.ts' ! -name '*.test.ts' ! -path '*/__tests__/*') --outdir=lib --platform=node --target=node22 --format=cjs && cp -r src/keys lib/keys",
    "lint": "biome check --write",
    "start": "COGNITO_LOCAL_DEVMODE=1 tsx src/bin/start.ts",
    "start:debug": "COGNITO_LOCAL_DEVMODE=1 DEBUG=1 tsx --inspect-brk src/bin/start.ts",
    "start:watch": "nodemon",
    "test": "vitest",
    "type-check": "tsc --target es2019 --esModuleInterop --resolveJsonModule --noEmit",
    "check:vendor-terms": "node scripts/check-no-vendor-terms.mjs",
    "generate:validation-model": "node scripts/generate-validation-model.mjs",
    "prepare": "node scripts/prepare.js",
    "cli": "tsx src/bin/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@types/aws-lambda": "^8.10.85",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^2.0.11",
    "amazon-cognito-identity-js": "^6.3.22",
    "aws-sdk": "^2.1145.0",
    "esbuild": "^0.25.8",
    "husky": "^7.0.4",
    "lint-staged": "^10.1.3",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^5.0.2",
    "@aws-sdk/client-cognito-identity-provider": "^3.1153.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "body-parser": "^2.3.0",
    "boxen": "^5.1.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash.mergewith": "^4.6.2",
    "nodemailer": "^10.1.7",
    "otplib": "^13.4.0",
    "pino": "^7.11.0",
    "pino-http": "^6.3.3",
    "pino-pretty": "^7.6.1",
    "short-uuid": "^6.0.3",
    "stormdb": "^0.5.2",
    "uuid": "^11.1.1"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "npm start"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write",
      "tsc --target es2019 --moduleResolution bundler --esModuleInterop --resolveJsonModule --noEmit ./setupTests.ts"
    ],
    "README.md": "markdown-toc -i --bullets=- --maxdepth=3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relbns/cognito-local.git"
  }
}
